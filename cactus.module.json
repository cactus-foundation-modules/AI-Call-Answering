{
  "name": "ai-call-answering",
  "version": "0.1.19",
  "tablePrefix": "acall_",
  "notificationKinds": [
    {"id": "callback", "label": "Callback requests from the phone assistant", "description": "The phone assistant could not help a caller and took their name and email so somebody can get back to them.", "dedupePrefix": "ai-call-answering:callback:"},
    {"id": "unanswered", "label": "Weekly list of questions the phone assistant could not answer", "description": "Each Monday, how many caller questions last week the assistant had no answer for: the FAQs, pages or tools worth adding next.", "dedupePrefix": "ai-call-answering:unanswered:"}
  ],
  "description": "A voice assistant that answers your phone. It speaks with the latest ElevenLabs voices, answers questions about your products, suggests things from the shop, checks on orders once the caller has proved who they are, and takes a name and email for anything it cannot help with. Every call lands in the unified inbox with a written overview.",
  "requiresCoreVersion": "0.5.1852",
  "requiresModules": [
    {"name": "twilio", "minVersion": "0.1.51"},
    {"name": "shop", "minVersion": "0.1.518"},
    {"name": "unified-inbox", "minVersion": "0.1.134"}
  ],
  "permissions": [
    "ai-call-answering.manage"
  ],
  "requiredEnvVars": [
    {
      "name": "ENCRYPTION_KEY",
      "required": true
    },
    {
      "name": "ELEVENLABS_API_KEY",
      "required": false
    }
  ],
  "cronJobs": [
    {
      "path": "/api/m/ai-call-answering/cron/resync",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/m/ai-call-answering/cron/unanswered",
      "schedule": "0 7 * * 1"
    }
  ],
  "cookieCategories": [],
  "cspOrigins": {
    "media": [
      "https://storage.googleapis.com",
      "https://api.elevenlabs.io",
      "https://api.us.elevenlabs.io",
      "https://api.eu.residency.elevenlabs.io",
      "https://api.in.residency.elevenlabs.io"
    ]
  },
  "settingsTabs": [
    {
      "id": "ai-call-answering",
      "label": "AI Call Answering",
      "permission": "ai-call-answering.manage",
      "import": "./components/admin/SettingsTab",
      "component": "AiCallAnsweringSettingsTab"
    }
  ],
  "extensionPoints": [
    {
      "point": "twilio.inbound-call-handler",
      "id": "ai-call-answering",
      "serverOnly": true,
      "import": "./lib/call-handler",
      "component": "aiInboundCallHandler"
    },
    {
      "point": "core.conversation-provider",
      "id": "ai-call-answering",
      "label": "AI calls",
      "permission": "ai-call-answering.manage",
      "serverOnly": true,
      "import": "./lib/conversation-provider",
      "component": "aiCallConversationProvider"
    }
  ],
  "emailTemplates": {
    "groupLabel": "Phone assistant",
    "import": "./lib/email-templates",
    "export": "aiCallAnsweringEmailTemplates"
  },
  "teardown": [
    "acall_baskets",
    "acall_unanswered",
    "acall_calls",
    "acall_fallback_keys",
    "acall_numbers",
    "acall_settings"
  ],
  "memberExtensions": {
    "activityTypes": [],
    "notificationCategories": [],
    "routeTiers": []
  }
}
